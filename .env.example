# Theia Website API Environment Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# Isolated Website Logical Database (PostgreSQL)
# Must connect to 'theia_website', NOT 'personal_fc'
DATABASE_URL=postgresql://theia_web_user:theia_web_password@postgres:5432/theia_website

# Website Content Redis Cache & Rate-Limiter
REDIS_URL=redis://redis:6379/1

# Financial Backend Integration (Market Data Feed)
# Internal container network URL to the authoritative FastAPI backend
FINANCE_API_INTERNAL_URL=http://theia-finance-api:8081

# Direct BRS Market Feed Credentials (Independent Website Feed)
BRS_API_KEY=BM42nXyL78h5NrpdMrEPaXDGLCYfgJMQ
BRS_COMMODITY_URL=https://api.brsapi.ir/Market/Commodity.php
BRS_GOLD_CURRENCY_URL=https://api.brsapi.ir/Market/Gold_Currency.php
BRS_CRYPTO_URL=https://api.brsapi.ir/Market/Cryptocurrency.php

# Editorial & Admin Authentication
JWT_SECRET=super_secret_website_cms_key_change_in_production
JWT_EXPIRATION_HOURS=12

# Allowed Origins for Admin & Web proxying
CORS_ORIGIN=https://theia-finance.ir,http://localhost:3000
